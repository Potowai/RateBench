<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde cloud et transfert d'appareil (API 31+). On exclut les jetons
   d'authentification Supabase : l'utilisateur se reconnectera après une
   restauration, ce qui est préférable à une fuite de session.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rate_bench_supabase_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rate_bench_supabase_auth.xml" />
    </device-transfer>
</data-extraction-rules>
